# Copy this to .env.local and fill in your values.
# .env.local is gitignored — never commit it.
#
# Get all VITE_FIREBASE_* values from:
#   Firebase Console → Project Settings → Your apps → Web app → Config
#
# Get VITE_GOOGLE_CLIENT_ID from:
#   Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration → Web client ID

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth Web Client ID (different from Firebase API key)
VITE_GOOGLE_CLIENT_ID=
